# ──────────────────────────────────────────────────────────────────────────────
# NeoFlo Visual Agent — Backend Environment Variables
# Copy this file to .env and fill in your values.
# docker compose up will use this file automatically.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# docker compose provides: postgresql://neoflo:neoflo_secret@localhost:5432/neoflo_agent
DATABASE_URL=postgresql://neoflo:neoflo_secret@localhost:5432/neoflo_agent

# ── Queue (Redis) ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32

# ── Vision AI (at least one key required) ──────────────────────────────────────
# Which provider to use: openai | anthropic  (default: openai)
VISION_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Screenshot Storage ─────────────────────────────────────────────────────────
# Which provider to use: local | s3  (default: local)
# "local" writes to ./uploads/ and serves via Express static — zero cloud setup
# "s3"    uploads to AWS S3 — requires the AWS_* vars below
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
