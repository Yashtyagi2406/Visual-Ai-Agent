FROM node:20-alpine

# Install OpenSSL for Prisma on Alpine
RUN apk add --no-cache openssl

WORKDIR /app

# Install dependencies first (layer cache)
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Generate Prisma client
RUN npx prisma generate

EXPOSE 3000

# Default: start API server (overridden for worker service)
CMD ["npm", "run", "dev"]
